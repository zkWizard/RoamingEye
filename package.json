{
  "name": "roamingeye",
  "version": "1.1.0",
  "description": "A high-fidelity, open-source 3D Earth you can roam from a satellite's-eye view.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --pool=threads --maxWorkers=4",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "test:e2e:engines": "playwright test --project=webkit --project=firefox",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:soak": "playwright test --config playwright.soak.config.ts",
    "agents:run": "node scripts/run-agent-fleet.mjs",
    "catalog:check": "node scripts/agents/qa-release.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run catalog:check && npm run build",
    "verify:full": "npm run verify && npm run test:e2e",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "gifenc": "^1.0.3",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "3d-tiles-renderer": "^0.5.3",
    "three": "^0.186.1"
  }
}
